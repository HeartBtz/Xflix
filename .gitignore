# ─────────────────────────────────────────────────────────────────
#  XFlix — .gitignore
# ─────────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Secrets — generated by install.sh, never commit
.env
*.env.local
.env.*.local
.admin-creds

# Generated thumbnails (re-created at runtime)
data/thumbs/*
!data/thumbs/.gitkeep

# PM2
.pm2/
ecosystem.config.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Cache & build artifacts
.npm/
.cache/
.node_repl_history
dist/
build/
*.tar.gz
*.zip
*.tgz

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
._*

# Editors & IDEs
.vscode/
.idea/
*.swp
*.swo
*.vim
*~
.project
.classpath
.settings/

# Test coverage
coverage/
.nyc_output/
