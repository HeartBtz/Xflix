# ═══════════════════════════════════════════════════════════════
#  XFlix — Environment Configuration
#  Copy to .env and adjust values:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────
PORT=3000

# Require a login for API data, thumbnails, photos, videos and downloads.
# Keep enabled for every Internet-facing installation.
REQUIRE_AUTH=true

# Reverse proxies running on this host are trusted by default.
# Set an explicit hop count or subnet only when your topology requires it.
TRUST_PROXY=loopback

# Auto-detected from trusted HTTPS requests by default. For an HTTPS-only public
# BASE_URL, force true even if the proxy-to-app connection is plain HTTP. This
# makes browser login over a direct plain-HTTP LAN address unsupported.
# Never trust arbitrary forwarding headers just to obtain a Secure cookie.
# COOKIE_SECURE=true

# ─── Media ────────────────────────────────────────────────────
# Absolute path to your media root directory.
# Each immediate subdirectory becomes a performer.
# Example: /home/user/Videos  or  /mnt/nas/media
MEDIA_DIR=/path/to/your/media

# Strict boolean: absent or false keeps media read-only. Never enabled on upgrade.
# Set true explicitly to allow admin deletion/quarantine/re-encoding, including
# deleteFile:false (its journal is stored in MEDIA_DIR/.xflix-trash).
# Reinstall the managed service after changing this flag. Existing filesystem
# write permissions for xflix are also required; the installer does not grant ACLs.
XFLIX_MEDIA_WRITE=false

# Missing-file DB cleanup is disabled unless explicitly enabled with a sentinel
# already present on the expected media filesystem. Never create it on a missing mount.
XFLIX_ALLOW_MISSING_CLEANUP=false
# XFLIX_STORAGE_SENTINEL=.xflix-storage-id
# XFLIX_STORAGE_SENTINEL_VALUE=your-unique-storage-identifier

# Thumbnail storage (auto-created by install.sh)
# Manual runtime default: <xflix>/data/thumbs. The managed installer requires
# the stable location /opt/xflix/data/thumbs; see scripts/INSTALLATION.md.
# THUMB_DIR=/opt/xflix/data/thumbs

# ─── Database (MariaDB / MySQL) ──────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=xflix
DB_PASS=changeme
DB_NAME=xflix

# ─── JWT Authentication ──────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Required in production. Development alone may generate a temporary key.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=12h

# ─── Base URL ─────────────────────────────────────────────────
# Used for password-reset emails AND canonical browser request-origin validation.
# Behind HTTPS ingress, set the exact public origin, not the HTTP backend URL.
# Browser mutations from other origins (including a direct LAN IP) are rejected.
BASE_URL=https://xflix.example.com

# ─── CORS ─────────────────────────────────────────────────────
# Same-origin only by default. Add a comma-separated allow-list only if needed.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# ─── SMTP (optional — for password reset emails) ─────────────
# Configure the SMTP host, account and secret in Admin -> Settings (stored in DB).
# SMTP_HOST/PORT/USER/PASS/FROM/SECURE env vars are not read by the mail service.
# Reset links are NEVER logged. Without SMTP and BASE_URL no reset email is sent.
# SMTP_ALLOW_SELF_SIGNED=false
